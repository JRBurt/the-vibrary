# Copy this file to .env and fill in real values. .env is gitignored.

# Where your real (private) markdown corpus lives on disk, OUTSIDE this repo.
# Expected layout: $VIBRARY_DATA_DIR/<collection>/**/*.md
# e.g. $VIBRARY_DATA_DIR/glossary/*.md, $VIBRARY_DATA_DIR/skills/*.md
VIBRARY_DATA_DIR=~/vibrary-data

# Postgres connection for the pgvector-backed index.
DATABASE_URL=postgresql://vibrary:vibrary@localhost:5433/vibrary

# Local embedding model (sentence-transformers). Loaded on first run, cached after.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
